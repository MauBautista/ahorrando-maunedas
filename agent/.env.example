# agent/.env.example — copiar a agent/.env (no se versiona). 07 §3.
# AGENT_TOKEN lo genera apps/api/scripts/agent-token.sh (el Worker guarda solo su sha256).
API_BASE=https://maunedas.maunedas.workers.dev
AGENT_TOKEN=
AGENT_ID=home
TZ=America/Mexico_City
DATA_DIR=/data
LOG_LEVEL=INFO

POLL_INTERVAL_S=60
SCRAPE_TICK_S=30
MAX_HTTP_CONCURRENCY=2
MAX_BROWSER_CONCURRENCY=1
PLAYWRIGHT_ENABLED=true
BROWSER_RESTART_EVERY=50
REFERENCE_POSTAL_CODE=72750
# CHROME_UA=Mozilla/5.0 (X11; Linux x86_64) … Chrome/153.0.0.0 Safari/537.36   (por omisión, el del Chromium de la imagen)
HTTP_TIMEOUT_S=20
BROWSER_TIMEOUT_S=40

BACKUP_ENABLED=true
BACKUP_HOUR=3
BACKUP_WEEKDAY=6
BACKUP_KEEP_WEEKLY=8
R2_ENDPOINT=
R2_BUCKET=maunedas-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

IMAGES_ENABLED=false
REMBG_MODEL=isnet-general-use
