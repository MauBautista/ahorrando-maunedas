<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the data lives in the Worker and comes back by sync after
     signing in (04 §6). Pending local changes stay on the device until they are pushed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
