{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-web-dist.ts && wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "node scripts/ensure-web-dist.ts && wrangler types && tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node scripts/ensure-web-dist.ts && vitest run",
    "deploy:dev": "pnpm --filter web build --mode dev && wrangler deploy --env dev",
    "deploy:prod": "pnpm --filter web build && wrangler deploy --env ''"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
